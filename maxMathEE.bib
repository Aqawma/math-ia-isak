@misc{plociniczakHopfBifurcation2019,
  title = {Hopf Bifurcation in a Conceptual Climate Model with Ice-Albedo and Precipitation-Temperature Feedbacks},
  author = {P{\l}ociniczak, {\L}ukasz},
  year = 2019,
  month = feb,
  number = {arXiv:1801.09087},
  eprint = {1801.09087},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1801.09087},
  urldate = {2026-04-10},
  abstract = {In this paper we analyse a dynamical system based on the so-called KCG (K\"all\'en, Crafoord, Ghil) conceptual climate model. This model describes an evolution of the globally averaged temperature and the average extent of the ice sheets. In the nondimensional form the model is prone to several simplifications facilitating the subsequent analysis. We consider the limiting case of the stationary snow line for which the phase plane can be completely analysed and the type of each stationary point can be determined. One of them can exhibit the Hopf bifurcation for which occurrence we find the sufficient conditions. Those, in turn, have a straightforward physical meaning and indicate that the model predicts internal oscillations of the climate. Using the typical values of model parameters we conclude that the obtained results are in the same ballpark as the conditions on our planet during the quaternary ice ages. Our analysis is a rigorous justification of a generalization of some previous results by KCG and other authors.},
  archiveprefix = {arXiv},
  keywords = {@remarkable,Mathematics - Dynamical Systems,Physics - Atmospheric and Oceanic Physics},
  file = {/Users/max/Zotero/storage/9KNZ67XM/Płociniczak - 2019 - Hopf bifurcation in a conceptual climate model with ice-albedo and precipitation-temperature feedbac.pdf;/Users/max/Zotero/storage/RXLC8LCH/1801.html}
}

